{
  "schema_version": "opl-package-app-contribution-adapter.v1",
  "reads": {
    "mag.workspace.v1#route": {
      "kind": "json_file",
      "root": "profile",
      "path": "${input.workspace_path}",
      "transform": "grant_workspace",
      "input_schema": {
        "type": "object",
        "required": ["workspace_path"],
        "properties": {
          "workspace_path": {
            "type": "string",
            "title": "Grant workspace JSON",
            "description": "Workspace-relative path to one MAG owner workspace JSON document."
          }
        },
        "additionalProperties": false
      }
    },
    "mag.workspace.v1#quality": {
      "kind": "json_file",
      "root": "profile",
      "path": "${input.quality_path}",
      "transform": "artifact_status",
      "input_schema": {
        "type": "object",
        "required": ["quality_path"],
        "properties": {
          "quality_path": {
            "type": "string",
            "title": "Grant quality artifact",
            "description": "Workspace-relative path to one MAG owner quality artifact JSON document."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "actions": {}
}
