{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "mag",
    "version": "0.4.5",
    "intent": "agent",
    "name": {
      "zh-CN": "Med Auto Grant",
      "en-US": "Med Auto Grant"
    },
    "summary": {
      "zh-CN": "医学基金申请规划、撰写、评审与修订。",
      "en-US": "Medical grant application planning, writing, review, and revision."
    },
    "description": {
      "zh-CN": "Adds a Codex plugin entry for Med Auto Grant with its owner contracts and hosted runtime source.",
      "en-US": "Adds a Codex plugin entry for Med Auto Grant with its owner contracts and hosted runtime source."
    },
    "publisher": "one-person-lab",
    "license": "Apache-2.0",
    "icon": "assets/branding/medautogrant-logo.png",
    "repository": "https://github.com/gaofeng21cn/med-autogrant",
    "homepage": "https://github.com/gaofeng21cn/med-autogrant",
    "keywords": [
      "grant-authoring",
      "codex",
      "medical-grant",
      "domain-agent"
    ],
    "routing_summary": {
      "zh-CN": "医学基金申请规划、撰写、评审与修订。",
      "en-US": "Enter the current MAG grant workflow and continue the same funding-call authoring loop."
    },
    "default_prompts": [
      "Inspect the current Med Auto Grant skill catalog for this workspace.",
      "Open the current Med Auto Grant status for this grant workspace.",
      "Continue the active Med Auto Grant user loop with the current funding call."
    ],
    "home_shortcuts": [
      {
        "id": "open_grant_user_loop",
        "label": {
          "zh-CN": "开展基金申请工作",
          "en-US": "Open MAG user loop"
        },
        "default_visible": true,
        "target": {
          "kind": "agent",
          "ref": "mag"
        }
      }
    ]
  },
  "dependencies": {
    "opl_base": "^2.0.0",
    "packages": [
      {
        "id": "mas-scholar-skills",
        "version": ">=0.2.25 <0.3.0",
        "optional": false,
        "required_capabilities": [
          "medical-research-lit",
          "medical-statistical-review",
          "medical-methodology-planner",
          "medical-evidence-integrity-reviewer",
          "medical-evidence-synthesis-and-claim-map",
          "medical-reference-integrity-auditor"
        ],
        "required_module_ids": [
          "mas-scholar-skills.lit",
          "mas-scholar-skills.stats",
          "mas-scholar-skills.review",
          "mas-scholar-skills.data",
          "mas-scholar-skills.reference-provider-adapters",
          "mas-scholar-skills.scientific-search-adapters"
        ]
      }
    ],
    "runtimes": [
      {
        "name": "python",
        "version": ">=3.12"
      }
    ]
  },
  "permissions": {
    "workspace": {
      "access": "read_write",
      "reason": {
        "zh-CN": "读取基金申请工作区数据并写入草稿、评审意见与提交包",
        "en-US": "Read grant workspace data and write drafts, review feedback, and submission packages"
      }
    },
    "knowledge": [
      {
        "scope": "long_term_topic",
        "access": "read",
        "required": false,
        "reason": {
          "zh-CN": "按需引用个人策略记忆与基金规范",
          "en-US": "Reference personal grant strategy notes and standards on demand"
        }
      }
    ],
    "network": "outbound_api",
    "execution_mode": "local_subprocess"
  },
  "provides": {
    "agent": {
      "stages_ref": "agent/stages/manifest.json"
    },
    "skills": [
      {
        "id": "med-autogrant",
        "path": "./skills/med-autogrant",
        "exposure": "default"
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "python3",
        "./runtime/app_contribution.py"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "mag.workspace.route",
          "view_type": "list_detail",
          "slot": "runtime.detail",
          "title": {
            "zh-CN": "基金工作区阶段",
            "en-US": "Grant workspace route"
          },
          "data_ref": "mag.workspace.v1#route",
          "empty_state": {
            "zh-CN": "选择一个基金工作区后读取当前阶段",
            "en-US": "Select a grant workspace to inspect its current stage"
          },
          "actions": [
            {
              "id": "mag.review.note",
              "label": {
                "zh-CN": "记录审阅意见",
                "en-US": "Record review feedback"
              },
              "action_ref": "mag.workspace.v1#review.note",
              "confirm": true,
              "effect_timing": "immediate"
            }
          ]
        },
        {
          "id": "mag.workspace.quality",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "基金申请质量",
            "en-US": "Grant quality"
          },
          "data_ref": "mag.workspace.v1#quality",
          "empty_state": {
            "zh-CN": "选择基金工作区，查看当前草稿与评审证据",
            "en-US": "Select a grant workspace to inspect the current draft and review evidence"
          },
          "actions": [
            {
              "id": "mag.review.note",
              "label": {
                "zh-CN": "记录审阅意见",
                "en-US": "Record review feedback"
              },
              "action_ref": "mag.workspace.v1#review.note",
              "confirm": true,
              "effect_timing": "immediate"
            }
          ]
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/mag",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": true,
      "plugin_name": "med-autogrant",
      "category": "Research",
      "brand_color": "#2E6E9E",
      "capabilities": [
        "Interactive",
        "Write"
      ]
    }
  }
}
