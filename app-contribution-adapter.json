{
  "schema_version": "opl-package-app-contribution-adapter.v1",
  "reads": {
    "mag.workspace.v1#route": {
      "kind": "json_file",
      "root": "profile",
      "path": "${input.workspace_file}",
      "transform": "grant_workspace",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_file": {
            "type": "string",
            "default": "workspace.json",
            "title": "Grant workspace JSON",
            "description": "Workspace-relative path to one MAG owner workspace JSON document."
          }
        },
        "additionalProperties": false
      }
    },
    "mag.workspace.v1#quality": {
      "kind": "json_file",
      "root": "profile",
      "path": "${input.quality_path}",
      "transform": "artifact_status",
      "input_schema": {
        "type": "object",
        "properties": {
          "quality_path": {
            "type": "string",
            "default": "workspace.json",
            "title": "Grant assessment source",
            "description": "Uses the current workspace's owner-authored draft, critique and revision evidence by default. Select an exact quality artifact to inspect an exported scorecard."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "actions": {}
}
